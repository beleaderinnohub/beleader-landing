---
const channels = [
  { label: "Email", value: "puc.chime@gmail.com", href: "mailto:puc.chime@gmail.com" },
  { label: "LinkedIn", value: "in/puchime", href: "https://www.linkedin.com/in/puchime" },
  { label: "YouTube", value: "@PRINCEUGOCHIME", href: "https://www.youtube.com/@PRINCEUGOCHIME" },
];
---
<section id="contact" class="border-t border-navy-600/40">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <p class="eyebrow mb-4">contact</p>
    <h2 class="font-display text-3xl font-700 text-white md:text-4xl">Talk to us</h2>
    <p class="mt-4 max-w-2xl font-sans text-muted-400">
      Questions about a program, partnerships, or corporate training? Reach out on any channel.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {channels.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith("http") ? "_blank" : undefined}
          rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="rounded-xl border border-navy-600/50 bg-navy-800/50 p-6 transition hover:border-gold-500"
        >
          <p class="font-mono text-xs uppercase tracking-widest text-gold-500">{c.label}</p>
          <p class="mt-2 font-sans text-ice-200">{c.value}</p>
        </a>
      ))}
    </div>
  </div>
</section>
