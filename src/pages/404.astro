---
import Base from "../layout/Base.astro";
---
<Base title="Page not found | Be-leader Innovation Hub">
  <section class="mx-auto flex max-w-3xl flex-col items-start px-6 py-32">
    <p class="eyebrow mb-4">404</p>
    <h1 class="font-display text-4xl font-700 text-white">This page took a wrong turn</h1>
    <p class="mt-4 font-sans text-muted-400">
      The page you were looking for isn't here. Let's get you back on track.
    </p>
    <a href="/" class="mt-8 rounded-md bg-gold-500 px-6 py-3 font-sans font-600 text-navy-950">Back to home</a>
  </section>
</Base>
